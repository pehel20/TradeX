# Backend Environment Variables
# Copy this to .env and fill in your values

# MongoDB connection string (required)
MONGO_URL=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/zerodha

# Gemini AI API key for chatbot (optional - falls back to local knowledge base if missing)
GEMINI_API_KEY=your-gemini-api-key

# JWT secret for authentication (required)
JWT_SECRET=your-strong-secret-key

# Port (optional - defaults to 3002, hosting platforms set this automatically)
PORT=3002

# CORS: comma-separated list of allowed frontend origins (optional - defaults to allow all)
# Example: https://tradex-frontend.vercel.app,https://tradex-dashboard.vercel.app
ALLOWED_ORIGINS=
